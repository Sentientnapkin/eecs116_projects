+/* flow-direction estimate of the camera translation direction between the first and the newest clone */
+static int flow_dir(double *dirc, double *scale_out) {
+    if (nclones < VI_CLONES) return 0;
+    const Clone *c0 = &clones[0], *c1 = &clones[nclones - 1];
+    double Rw0[9], p0[3], Rw1[9], p1[3], Rrel[9];
+    camera_pose(c0, Rw0, p0); camera_pose(c1, Rw1, p1);
+    m3tmul(Rw1, Rw0, Rrel); /* cam0 -> cam1 */
+    double N[9] = {0}, b[3] = {0}; int n = 0;
+    for (int i = 0; i < MAX_TRACKS; i++) {
+        const Obs *o = &tracks[i].obs;
+        if (!tracks[i].alive) continue;
+        int k0 = -1, k1 = -1;
+        for (int j = 0; j < o->n; j++) { if (o->cid[j] == c0->id) k0 = j; if (o->cid[j] == c1->id) k1 = j; }
+        if (k0 < 0 || k1 < 0) continue;
+        double ray[3] = {o->x[k0], o->y[k0], 1.0}, rp[3];
+        m3vec(Rrel, ray, rp);
+        if (rp[2] <= 0.1) continue;
+        double x0 = rp[0] / rp[2], y0 = rp[1] / rp[2], x1 = o->x[k1], y1 = o->y[k1];
+        double ux = x1 - x0, uy = y1 - y0; /* flow in cam1 normalized coords after de-rotation */
+        /* u = s (x v_z - v_x), (a = s v): rows [-1 0 x] a = ux ; [0 -1 y] a = uy  (use mid point x=(x0+x1)/2) */
+        double xm = 0.5 * (x0 + x1), ym = 0.5 * (y0 + y1);
+        double r1[3] = {-1, 0, xm}, r2[3] = {0, -1, ym};
+        for (int a = 0; a < 3; a++) { for (int c = 0; c < 3; c++) N[3 * a + c] += r1[a] * r1[c] + r2[a] * r2[c]; b[a] += r1[a] * ux + r2[a] * uy; }
+        n++;
+    }
+    if (n < 8) return 0;
+    double a[3];
+    if (!solve3(N, b, a)) return 0;
+    double na = sqrt(a[0] * a[0] + a[1] * a[1] + a[2] * a[2]);
+    if (na < 1e-9) return 0;
+    for (int i = 0; i < 3; i++) dirc[i] = a[i] / na;
+    *scale_out = na;
+    return n;
+}
