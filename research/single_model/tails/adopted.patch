+static void update_tex_scale(int which) { /* mean abs gradient of the level-0 gray image, stride 3 */
+    if (!(TAILS_DET || TAILS_KLT)) return;
+    const uint8_t *I = pyr[which][0];
+    double sum = 0; int cnt = 0;
+    for (int y = 1; y < IMG_H - 1; y += 3)
+        for (int x = 1; x < IMG_W - 1; x += 3) {
+            const uint8_t *p = I + y * IMG_W + x;
+            sum += 0.5 * (abs(p[1] - p[-1]) + abs(p[IMG_W] - p[-IMG_W])); cnt++;
+        }
+    double g = sum / cnt / 2.0;
+    if (TAILS_EMA > 0) { /* slow average over the last ~1/TAILS_EMA frames: scene-wide flatness, not a plain wall in view */
+        static int have;
+        if (!have) { g_ema = g; have = 1; } else g_ema += TAILS_EMA * (g - g_ema);
+        g = g_ema;
+    }
+    double r = g / TAILS_G0;
+    r *= r;
+    tex_scale = r > 1 ? 1 : r < TAILS_SMIN ? TAILS_SMIN : r;
+    if (TAILS_BRIGHT) {
+        long bs = 0;
+        for (int i = 0; i < IMG_W * IMG_H; i += 7) bs += I[i];
+        double b = (double)bs / (IMG_W * IMG_H / 7) / 130.0;
+        b *= b; if (b > 1) b = 1; if (b < 0.15) b = 0.15;
+        if (b < tex_scale) tex_scale = b;
+    }
+}
