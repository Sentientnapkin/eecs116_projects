+static void vi_reset(void) {
+    double d[3], sc;
+    int n = flow_dir(d, &sc);
+    if (n < VI_NMIN) return;
+    if (d[2] > VI_COSMAX) { vi_ok = 2; return; } /* flow direction agrees with the heading prior: keep it */
+    vi_ok = 1;
+    const Clone *c0 = &clones[0], *c1 = &clones[nclones - 1];
+    double dt = (c1->id - c0->id) * CLONE_EVERY * FRAME_DT;
+    double speed = sc / dt * VI_Z0;
+    if (speed > 3.0) speed = 3.0;
+    if (speed < 0.05) speed = 0.05;
+    double Rw1[9], p1[3], dw[3], C[9];
+    camera_pose(c1, Rw1, p1);
+    m3vec(Rw1, d, dw);
+    for (int j = 0; j < D; j++)
+        for (int i = V; i < V + 3; i++) { Pm[i * MAXD + j] = 0; Pm[j * MAXD + i] = 0; }
+    double sp = fmax(VI_SFLOOR, VI_SPAR * speed), sq = fmax(VI_SFLOOR, VI_SPERP * speed);
+    for (int i = 0; i < 3; i++) {
+        vel[i] = dw[i] * speed;
+        for (int j = 0; j < 3; j++) C[3 * i + j] = sq * sq * ((i == j) - dw[i] * dw[j]) + sp * sp * dw[i] * dw[j];
+    }
+    set_block(V, V, C, 1);
+    if (VI_POS) {
+        double el = last_t - t_start;
+        for (int i = 0; i < 3; i++) { double np = vel[i] * el; pos[i] = np; clones[nclones - 1].p[i] = np; }
+    }
+}
