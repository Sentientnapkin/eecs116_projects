+static double rec_until = -1e9, rec_last = -1e9;
+static void recovery(double t) {
+    double ts = t - t_first;
+    if (t > rec_until) cur_z = CHI2_Z;
+    int trig = 0;
+    double a = 0, b = 0;
+    if (HC_REC_VSTD > 0 && ts >= HC_REC_T0) {
+        double sv = sqrt(Pm[V * MAXD + V] + Pm[(V + 1) * MAXD + V + 1] + Pm[(V + 2) * MAXD + V + 2]);
+        if (sv > HC_REC_VSTD) { trig |= 1; a = sv; }
+    }
+    if (HC_REC_SPEED > 0 && ts < HC_REC_TMAX && ts >= 1.0) {
+        double sp = sqrt(vel[0] * vel[0] + vel[1] * vel[1] + vel[2] * vel[2]);
+        if (sp > HC_REC_SPEED) { trig |= 2; b = sp; }
+    }
+    if (frame_no % 20 == 0) { /* 1 s window */
+        if (ts >= 1.5) {
+            if (HC_REC_TRIFAIL > 0 && fw_att >= 5 && (double)fw_fail / fw_att > HC_REC_TRIFAIL) { trig |= 4; a = (double)fw_fail / fw_att; }
+            if (HC_REC_MINUSED > 0 && fw_used < HC_REC_MINUSED) { trig |= 8; b = fw_used; }
+        }
+        fw_att = fw_fail = fw_used = 0;
+    }
+    if (!trig || t - rec_last < HC_REC_COOL) return;
+    rec_last = t; rec_until = t + HC_REC_RELAX; cur_z = HC_REC_Z;
+    hc_log(7, t, trig, a + b);
+    for (int i = 0; i < 3; i++) Pm[(V + i) * MAXD + V + i] += HC_REC_VINF * HC_REC_VINF;
+    for (int i = 0; i < 2; i++) {
+        Pm[(TH + i) * MAXD + TH + i] += HC_REC_TINF * HC_REC_TINF;
+        Pm[(TH + i) * MAXD + TH0 + i] += HC_REC_TINF * HC_REC_TINF;
+        Pm[(TH0 + i) * MAXD + TH + i] += HC_REC_TINF * HC_REC_TINF;
+        Pm[(TH0 + i) * MAXD + TH0 + i] += HC_REC_TINF * HC_REC_TINF;
+    }
+    if (HC_REC_ZERO) {
+        double sc = sqrt(SPEED_TAU / FRAME_DT), r3[3];
+        memset(Hs, 0, sizeof Hs);
+        for (int i = 0; i < 3; i++) { Hs[i * MAXD + V + i] = 1 / (SPEED_STD * sc); r3[i] = -vel[i] / (SPEED_STD * sc); }
+        update(r3, Hs, 3, 1.0, INFINITY);
+    }
+}
